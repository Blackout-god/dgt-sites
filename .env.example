# Local defaults work without this file. Copy values to apps/storefront/.env.local
# for a native run, or edit the web service environment in compose.yaml.
NEXT_PUBLIC_HUB_URL=http://localhost:8787
# Leave blank for local preview. Set to the confirmed HTTPS brand domain for production.
NEXT_PUBLIC_SITE_URL=
# Docker Compose reads these from a root .env file. Native scripts also accept
# the same environment variables; the URL below is already the default.
FEED_URL=https://dream-group-toys.com.ua/export_xml_dgt/five_brands.xml
# Optional offline fixture, explicitly enabled only when needed:
# FEED_FILE=five_brands.xml
